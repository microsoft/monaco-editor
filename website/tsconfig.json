{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"ignoreDeprecations": "6.0",
		"strict": true,
		"outDir": "dist",
		"skipLibCheck": true,
		"resolveJsonModule": true,
		"newLine": "LF",
		"sourceMap": true,
		"useDefineForClassFields": false,
		"noEmit": true
	},
	"exclude": [
		"src/**/*",
		"./node_modules/monaco-editor/monaco.d.ts"
	]
}
