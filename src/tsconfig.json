{
	"compilerOptions": {
		"declaration": true,
		"lib": [
			"dom",
			"es5",
			"es2015.collection",
			"es2015.promise",
			"es2015.iterable"
		],
		"module": "esnext",
		"moduleResolution": "bundler",
		"rootDir": ".",
		"outDir": "../out/languages/tsc",
		"emitDeclarationOnly": true,
		"strict": true,
		"skipLibCheck": true,
		"target": "esnext",
		"sourceMap": true,
		"allowJs": true,
		"checkJs": false
	}
}
